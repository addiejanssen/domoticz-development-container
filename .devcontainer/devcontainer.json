{
	"name": "Domoticz Dev Container",
    "image": "mcr.microsoft.com/vscode/devcontainers/python",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.flake8",
                "bowlerr.sqlite-intelliview-vscode"
            ]
        }
    },
    "containerEnv": {
        "DOMOTICZ_DIR": "${containerWorkspaceFolder}/domoticz"
    },
    "runArgs": [
		"--userns=keep-id:uid=1000,gid=1000"
	   ],
	"containerUser": "vscode",
	"updateRemoteUserUID": true,
	"postCreateCommand": {
        "remove from git": "rm -rf .git .gitignore",
        "install OS dependencies": "sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get install -y curl unzip wget sudo cron libudev-dev libmosquitto1 libcurl4-gnutls-dev libusb-0.1",
        "upgrade pip": "python3 -m pip install --upgrade pip",
        "alias ll": "echo alias ll=\\'ls -lav --group-directories-first\\' >> ~/.bash_aliases"
	}
}